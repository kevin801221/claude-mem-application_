# 複製成 config/report.env 後修改（report.env 不會被 git 追蹤）
# Mac 與 Windows 的排程腳本都會讀這個檔案

# 日報上署名
AUTHOR=Luo

# 選用：日報寫完後要送到哪裡（notion / jira），留空代表只存檔
# 需要在 Claude Code 先接好對應的連接器
REPORT_DESTINATION=

# claude -p 執行時允許使用的工具，逗號分隔
# 第一次請先在 Claude Code 裡執行 /mcp，查出 claude-mem 搜尋伺服器的實際名稱，
# 再把 mcp__<伺服器名稱> 加進來（例如 mcp__plugin_claude-mem_mcp-search）
ALLOWED_TOOLS=Read,Write,Edit,Glob,Grep

# 主管端使用：所有成員報告匯集的資料夾
TEAM_REPORTS_DIR=

# 會議錄音轉文字：whisperx 模型與語言
WHISPER_MODEL=large-v3
WHISPER_LANGUAGE=zh

# 分辨說話者需要 Hugging Face token（需先在 HF 同意 pyannote 模型的使用條款）
HF_TOKEN=
